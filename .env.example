OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Database dati (Postgres su Railway). Supabase resta solo per l'autenticazione.
# In Railway usa la variabile DATABASE_URL del servizio Postgres (rete interna);
# da locale usa DATABASE_PUBLIC_URL.
DATABASE_URL=
# true solo se il tuo Postgres richiede SSL (di solito non serve su Railway)
DATABASE_SSL=false
